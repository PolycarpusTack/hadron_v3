{
  "name": "hadron-electron",
  "version": "5.0.0",
  "description": "Hadron - AI Support Assistant (Electron)",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "test": "vitest run",
    "postinstall": "echo 'Run npm run rebuild-native before packaging (Windows only)'",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@keeper-security/secrets-manager-core": "^17.4.0",
    "better-sqlite3": "^12.9.0",
    "date-fns": "^2.30.0",
    "docx": "^9.6.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "focus-trap-react": "^12.0.0",
    "lucide-react": "^0.577.0",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.mediagenix.hadron",
    "productName": "Hadron",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/codexmgx",
        "to": "codexmgx"
      },
      {
        "from": "resources/splash.html",
        "to": "splash.html"
      },
      {
        "from": "resources/splash.png",
        "to": "splash.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
